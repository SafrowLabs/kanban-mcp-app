{
  "name": "kanban-interactive",
  "version": "1.0.0",
  "private": true,
  "description": "Client-side Kanban board, served to ChatGPT and Claude as an MCP App. The board runs entirely in the browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SafrowLabs/kanban-mcp-app.git"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.js",
    "build": "node scripts/build.js",
    "start": "node server/http.js",
    "start:stdio": "node server/stdio.js",
    "test": "node --test tests/",
    "test:e2e": "npm run build && node --test tests/e2e/board.e2e.js tests/e2e/host.e2e.js",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.5"
  }
}
